# Copy to .env.production on the server and fill in every value. NEVER commit .env.production.
# Used by: docker compose --env-file .env.production --profile app up -d --build

# ---- docker compose (on the server: ln -s .env.production .env, then plain `docker compose up -d --build` works)
COMPOSE_PROFILES=app

# ---- domain & database (used by docker compose itself)
DOMAIN=sidebooster.com
POSTGRES_USER=sidebooster
POSTGRES_DB=sidebooster
# long random password: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- app
APP_URL=https://sidebooster.com
# openssl rand -hex 32   (64 hex chars — back this up, never change it later)
ENCRYPTION_KEY=
# openssl rand -hex 24
CRON_SECRET=

# ---- first start only: creates the Super Admin, then DELETE ADMIN_PASSWORD from this file
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_MOBILE=+614
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# ---- payments
# Staging/testing only (simulated gateway). Remove for the real launch.
ALLOW_TEST_PAYMENTS=true
# Real payments (after testing Stripe in test mode):
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
