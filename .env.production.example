# Copy to .env.production on the server and fill in every value. NEVER commit .env.production.
# Used by: docker compose --env-file .env.production --profile app up -d --build

# ---- docker compose (on the server: ln -s .env.production .env, then plain `docker compose up -d --build` works)
# app = database, app and cron; caddy = built-in HTTPS proxy. Use just "app" if nginx already serves ports 80/443.
COMPOSE_PROFILES=app,caddy

# ---- domain & database (used by docker compose itself)
DOMAIN=sidebooster.com
POSTGRES_USER=sidebooster
POSTGRES_DB=sidebooster
# long random password: openssl rand -hex 24
POSTGRES_PASSWORD=
# host port for the database (only reachable from the server itself); change if 5432 is already in use
DB_HOST_PORT=5433
# host port for the app (Caddy talks to it internally; this is only for curl on the server); change if 3000 is in use
APP_HOST_PORT=3001

# ---- app
APP_URL=https://sidebooster.com
# openssl rand -hex 32   (64 hex chars — back this up, never change it later)
ENCRYPTION_KEY=
# openssl rand -hex 24
CRON_SECRET=

# ---- first start only: creates the Super Admin, then DELETE ADMIN_PASSWORD from this file
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_MOBILE=+614
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# ---- payments
# Staging/testing only (simulated gateway). Remove for the real launch.
ALLOW_TEST_PAYMENTS=true
# Real payments (after testing Stripe in test mode):
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- push notifications (Firebase Cloud Messaging). Optional: without it, push is skipped.
# Firebase Console → Project settings → Service accounts → Generate new private key (downloads a .json),
# then on the server:  echo "FIREBASE_SERVICE_ACCOUNT=$(base64 -w0 key.json)" >> .env.production && rm key.json
# FIREBASE_SERVICE_ACCOUNT=

# ---- seller verification
# Live ABN/ACN lookups on the Australian Business Register (free GUID: https://abr.business.gov.au/Tools/WebServices)
# ABR_GUID=
# Optional: Google Geocoding API key for street-level address checks (default: OpenStreetMap)
# GOOGLE_MAPS_API_KEY=
