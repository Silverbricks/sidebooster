# ---------------------------------------------------------------- required
# Local: `docker compose up -d db` gives you this database.
DATABASE_URL="postgresql://sidebooster:sidebooster@localhost:5432/sidebooster"
# Public URL of the site (https:// in production). Used in emails, Stripe redirects, sitemap.
APP_URL="http://localhost:3000"
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
# Random string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/tick
CRON_SECRET=""

# ---------------------------------------------------------------- payments
# Simulated gateway for local/staging ONLY. Remove in production.
ALLOW_TEST_PAYMENTS="true"
# Live payments (Stripe Connect):
# PAYMENT_PROVIDER="stripe"
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------- first deploy only
# `npm run bootstrap` (runs automatically on container start) creates this Super Admin if none exists.
# Remove ADMIN_PASSWORD from the environment after the first successful start.
# ADMIN_EMAIL="you@yourdomain.com.au"
# ADMIN_PASSWORD="a-long-unique-password"
# ADMIN_MOBILE="+614XXXXXXXX"
# ADMIN_FIRST_NAME="Super"
# ADMIN_LAST_NAME="Admin"

# ---------------------------------------------------------------- storage (optional)
# Defaults to ./uploads and ./private-uploads. The Docker image uses /data/... (mount a volume there).
# UPLOAD_DIR="/data/uploads"
# PRIVATE_UPLOAD_DIR="/data/private-uploads"

# ---------------------------------------------------------------- tests (optional)
# TEST_DATABASE_URL="postgresql://sidebooster:sidebooster@localhost:5432/sidebooster_test"

# ---------------------------------------------------------------- email & SMS delivery
# Without these, messages (including sign-up and sign-in codes) only appear in Admin → Email / SMS outbox.
# With them, messages are really sent and one-time codes are redacted from the outbox log.
# Email via Resend (https://resend.com) — verify your sending domain there first.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="SideBooster <no-reply@sidebooster.com>"
# SMS via Twilio — use a number or Messaging Service enabled for Australia.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+61..."            # or TWILIO_MESSAGING_SERVICE_SID="MG..."
