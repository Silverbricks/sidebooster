{
  "name": "sidebooster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "bootstrap": "tsx prisma/bootstrap.ts",
    "start:prod": "prisma migrate deploy && tsx prisma/bootstrap.ts && next start",
    "typecheck": "tsc --noEmit",
    "test:flows": "sh -c \"export DATABASE_URL=${TEST_DATABASE_URL:-postgresql://sidebooster:sidebooster@localhost:5432/sidebooster_test} && prisma migrate deploy >/dev/null && tsx prisma/seed.ts >/dev/null && tsx --conditions=react-server scripts/test-flows.ts\"",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.16",
    "next": "15.5.29",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.18"
  }
}
